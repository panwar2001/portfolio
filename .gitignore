.DS_Store
.env

# Dependencies
/node_modules/

# React Router build output
/.react-router/
/build/

# Wrangler local state (emulated D1 + cache)
/.wrangler/

# Generated by `wrangler types` (npm run cf-typegen) from wrangler.jsonc
/worker-configuration.d.ts

# Local-only secrets / overrides (`.dev.vars.example` is committed)
.dev.vars
.dev.vars.*
!.dev.vars.example

# TypeScript incremental build metadata
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
