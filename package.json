{
  "name": "ayush-panwar-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio for Ayush Panwar — indie Android app developer. React Router v8 framework mode on Cloudflare Workers with D1.",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typegen": "wrangler types && react-router typegen",
    "typecheck": "npm run typegen && tsc -b",
    "cf-typegen": "wrangler types",
    "seed:generate": "node --experimental-strip-types scripts/generate-seed.ts",
    "db:setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "db:setup:remote": "npm run db:migrate:remote && npm run db:seed:remote",
    "db:migrate:local": "wrangler d1 migrations apply portfolio_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply portfolio_db --remote",
    "db:seed:local": "wrangler d1 execute portfolio_db --local --file=./db/seed.sql",
    "db:seed:remote": "wrangler d1 execute portfolio_db --remote --file=./db/seed.sql",
    "db:create": "wrangler d1 create portfolio_db",
    "db:studio": "wrangler d1 execute portfolio_db --local --command=\"select name from sqlite_master where type='table'\"",
    "sync:apps": "node --experimental-strip-types scripts/sync-app-store-data.ts"
  },
  "dependencies": {
    "isbot": "^5.1.36",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.9",
    "@react-router/dev": "^8.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "google-play-scraper": "^10.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "wrangler": "^4.131.2"
  }
}
